
<?php
require_once __DIR__ . '/../config/auth.php';
require_login();

require_once __DIR__ . '/../config/database.php';

$numero = $_GET['numero'] ?? '';

if ($numero === '') {
    header('Location: index.php');
    exit;
}

$stmt = $pdo->prepare("
    SELECT
        sp.id,
        sp.numero,
        sp.numero_officiel,
        sp.nom,
        COUNT(f.id) AS nombre_fitandremana
    FROM synodam_paritany sp
    LEFT JOIN fitandremana f
        ON f.sp_id = sp.id
    WHERE sp.numero_officiel = ?
    GROUP BY sp.id
    ORDER BY sp.id ASC
");

$stmt->execute([$numero]);
$parties = $stmt->fetchAll(PDO::FETCH_ASSOC);

// if (!$parties) {
//     header('Location: index.php');
//     exit;
// }



function e($value): string {
    return htmlspecialchars((string)($value ?? ''), ENT_QUOTES, 'UTF-8');
}

$nomUtilisateur = $_SESSION['nom_complet'] ?? $_SESSION['username'] ?? '';
$initiale = mb_strtoupper(
    mb_substr((string)$nomUtilisateur, 0, 1, 'UTF-8'),
    'UTF-8'
);

$totalFitandremana = array_sum(
    array_map(
        fn($partie) => (int)$partie['nombre_fitandremana'],
        $parties
    )
);
?>

