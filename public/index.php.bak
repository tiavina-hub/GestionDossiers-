<?php
require_once __DIR__ . '/../config/auth.php';

require_login();

require_once __DIR__ . '/../config/database.php';

/*
 * On regroupe les différentes parties d'un même SP
 * avec numero_officiel.
 *
 * Exemple :
 * SP 20 :
 * - IARIVO AVARADRANO 20
 * - MAEVATSARA 20 (1)
 * - MAEVATSARA 20 (2)
 */

$stmt = $pdo->query("
    SELECT
        sp.numero_officiel,
        COUNT(DISTINCT sp.id) AS nombre_parties,
        COUNT(f.id) AS nombre_fitandremana
    FROM synodam_paritany sp
    LEFT JOIN fitandremana f
        ON f.sp_id = sp.id
    GROUP BY sp.numero_officiel
    ORDER BY CAST(sp.numero_officiel AS UNSIGNED) ASC
");

$sps = $stmt->fetchAll(PDO::FETCH_ASSOC);

?>

