        <?php foreach ($sps as $sp): ?>

            <div class="col-md-4 col-lg-3">

                <div class="card shadow-sm h-100 sp-card">

                    <div class="card-body text-center">

                        <div class="sp-number text-primary">
                            SP <?= htmlspecialchars($sp['numero_officiel']) ?>
                        </div>

                        <p class="text-muted mb-2">
                            <?= (int)$sp['nombre_fitandremana'] ?>
                            Fitandremana
                        </p>

                        <?php if ((int)$sp['nombre_parties'] > 1): ?>

                            <span class="badge bg-warning text-dark mb-3">
                                <?= (int)$sp['nombre_parties'] ?> parties
                            </span>

                        <?php else: ?>

                            <span class="badge bg-success mb-3">
                                1 partie
                            </span>

                        <?php endif; ?>

                        <br>

                        <a
                            href="sp.php?numero=<?= urlencode($sp['numero_officiel']) ?>"
                            class="btn btn-primary"
                        >
